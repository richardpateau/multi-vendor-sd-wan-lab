config firewall address
    edit "iPerf-Server"
        set subnet 192.168.1.10 255.255.255.255
    next
end
----------------------------
config system sdwan
    config service
        edit 3
            set name "Active-Active-iPerf"
            set mode load-balance
            set dst "iPerf-Server"
            set hash-mode src-dst-ip
            set health-check "ISP_A_Monitor" "ISP_B_Monitor"
            end
        next
    end
end
-----------------------------
config system sdwan
    config health-check
        edit "ISP_A_Monitor"
            config sla
                edit 2
                    set latency-threshold 250
                    set jitter-threshold 50
                    set packetloss-threshold 5
                next
            end
        next
    end
end

config system sdwan
    config health-check
        edit "ISP_B_Monitor"
            config sla
                edit 2
                    set latency-threshold 250
                    set jitter-threshold 50
                    set packetloss-threshold 5
                next
            end
        next
    end
end
--------------------------------------
config firewall address
    edit "iPerf-10"
        set subnet 192.168.1.10 255.255.255.255
    next
    edit "iPerf-15"
        set subnet 192.168.1.15 255.255.255.255
    next
    edit "iPerf-20"
        set subnet 192.168.1.20 255.255.255.255
    next
end

config firewall addrgrp
    edit "iPerf-Servers"
        set member "iPerf-10" "iPerf-15" "iPerf-20"
    next
end
