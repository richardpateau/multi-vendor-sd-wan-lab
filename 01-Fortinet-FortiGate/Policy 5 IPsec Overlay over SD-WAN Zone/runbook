config router static
    edit 0
        set dst 192.168.2.0 255.255.255.0
        set sdwan-zone VPN
    next
    edit 0
        set dst 192.168.2.0 255.255.255.0
        set distance 20
        set blackhole enable
    next
end

config router static
    edit 0
        set dst 192.168.1.0 255.255.255.0
        set sdwan-zone VPN
    next
    edit 0
        set dst 192.168.1.0 255.255.255.0
        set distance 20
        set blackhole enable
    next
end

