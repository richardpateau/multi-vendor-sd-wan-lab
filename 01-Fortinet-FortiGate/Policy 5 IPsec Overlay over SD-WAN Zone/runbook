
config vpn ipsec phase1-interface
    edit "HQ-BRANCH-VPN"
        set interface "port2"
        set ike-version 2
        set remote-gw 10.0.1.2
        set psksecret 
        set proposal des-sha256
        set dpd on-idle
        set auto-negotiate enable
    next
    edit "HQ-BRANCH-VPN-2"
        set interface "port3"
        set ike-version 2
        set remote-gw 10.0.2.2
        set psksecret Pateau1!
        set proposal des-sha256
        set dpd on-idle
        set auto-negotiate enable
    next
end

